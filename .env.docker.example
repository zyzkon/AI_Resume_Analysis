# 容器环境用的配置。复制成 .env.docker 再改，.env.docker 已被 .gitignore 忽略。
#
#   cp .env.docker.example .env.docker
#
# 和根目录 .env 的关键区别：主机名写的是 compose 的服务名 mysql / redis，
# 不是 127.0.0.1 —— 容器里的 127.0.0.1 指的是它自己那个容器。

# JWT 签名密钥，至少 32 字符。生成：
#   docker run --rm python:3.12-alpine python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=please-change-me-to-a-random-string-at-least-32-chars

# ---- MySQL ----
# 下面这行密码会同时被 MySQL 镜像（初始化用户）和 DATABASE_URL 使用，
# 改的时候两处必须一起改，否则应用能启动但一查库就 Access denied
MYSQL_ROOT_PASSWORD=please-change-root
MYSQL_DATABASE=resume_db
MYSQL_USER=resume
MYSQL_PASSWORD=please-change-app

# ---- 应用 ----
DATABASE_URL=mysql+pymysql://resume:please-change-app@mysql:3306/resume_db?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
# 容器内的绝对路径，对应 compose 里挂的 uploads 命名卷
UPLOAD_DIR=/app/uploads
DEBUG=false
# 留空 = 不允许任何跨域来源。生产形态是前端和接口同源（都从 Caddy 进来），
# 浏览器根本不发跨域请求，所以这里不需要列任何域名
CORS_ORIGINS=

# ---- 并发与连接池 ----
# 三层必须满足：闸门 ≤ 线程池 < 连接池
#   闸门   = 同时在处理的请求数，超出的在事件循环里排队
#   线程池 = 与闸门同值（启动时自动对齐）
#   连接池 = DB_POOL_SIZE + DB_MAX_OVERFLOW，必须比闸门大
# 为什么连接池要更大：FastAPI 的同步依赖和同步路由分多次进线程池，
# 中间数据库连接不归还，所以「占着连接的请求」可以比线程多
# 多副本部署要按 MySQL 的 max_connections 反算份额：
#   max_connections(151) / (api 副本数 + worker 数)
MAX_CONCURRENT_REQUESTS=30
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
# 池耗尽时的等待上限。正常情况下不会触发，留着是为了让不变量被破坏时快点报错
DB_POOL_TIMEOUT=5

# ---- 大模型 ----
# mock 不联网不花钱，先用它验证整条链路，再换成 openai
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
