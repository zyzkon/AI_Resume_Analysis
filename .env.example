# ===== 应用 =====
APP_NAME=Resume Analyzer API
APP_VERSION=0.1.0
DEBUG=true

# ===== 安全 =====
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=请替换为随机生成的 64 位字符串
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 数据库 =====
# 必须是 mysql+pymysql:// 前缀，config.py 里有校验器会拦掉 sqlite 和裸 mysql://
# 密码里的 @ : / 等字符要先做 URL 编码，否则会被当成连接串的分隔符
DATABASE_URL=mysql+pymysql://resume:你的密码@127.0.0.1:3306/resume_db?charset=utf8mb4
DB_ECHO=false

# ===== 跨域 =====
# 逗号分隔的完整 origin，必须带协议头，不能带路径，结尾斜杠会被自动去掉。
# localhost 与 127.0.0.1 是两个不同的 origin，端口也要精确匹配。
# 默认只放行 5173（Vite / Vue / React），换端口或上线时改这一行。
# 前端与接口同域部署（前端由 FastAPI 托管）时留空即可。
# DEBUG=false 时不允许写 *，配置校验会直接报错
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 文件上传 =====
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ===== Redis / Celery =====
REDIS_URL=redis://localhost:6379/0

# ===== 大模型 =====
# mock   : 不联网、不花钱、结果确定，开发阶段用这个
# openai : 走 OpenAI 兼容接口（DeepSeek / 通义 / Kimi / 本地 vLLM 都行）
LLM_PROVIDER=mock
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=90
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_MAX_INPUT_CHARS=20000
