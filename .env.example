# ===== 应用 =====
APP_NAME=Resume Analyzer API
APP_VERSION=0.1.0
DEBUG=true

# ===== 安全 =====
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=请替换为随机生成的 64 位字符串
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 数据库 =====
# 必须是 mysql+pymysql:// 前缀，config.py 里有校验器会拦掉 sqlite 和裸 mysql://
# 密码里的 @ : / 等字符要先做 URL 编码，否则会被当成连接串的分隔符
DATABASE_URL=mysql+pymysql://resume:你的密码@127.0.0.1:3306/resume_db?charset=utf8mb4
DB_ECHO=false

# ===== 文件上传 =====
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ===== Redis / Celery =====
REDIS_URL=redis://localhost:6379/0

# ===== 大模型 =====
# mock   : 不联网、不花钱、结果确定，开发阶段用这个
# openai : 走 OpenAI 兼容接口（DeepSeek / 通义 / Kimi / 本地 vLLM 都行）
LLM_PROVIDER=mock
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=90
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_MAX_INPUT_CHARS=20000
