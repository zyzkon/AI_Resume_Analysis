# ===== 应用 =====
APP_NAME=Resume Analyzer API
APP_VERSION=0.1.0
DEBUG=true

# ===== 安全 =====
SECRET_KEY=请执行 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成后替换
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 数据库 =====
DATABASE_URL=sqlite:///./app.db
DB_ECHO=false

# ===== 文件上传 =====
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ===== Redis / Celery =====
REDIS_URL=redis://localhost:6379/0

# ===== 大模型 =====
LLM_PROVIDER=mock
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
